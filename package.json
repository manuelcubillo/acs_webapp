{
  "name": "acs_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:branch": "dotenv -e .env.neon-branch -v ALLOW_NEON_DB=1 -- next dev",
    "dev:prod": "dotenv -e .env.prod -v ALLOW_NEON_DB=1 -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:setup": "tsx scripts/db/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "dotenv -v DRIZZLE_TARGET=test -- drizzle-kit migrate",
    "db:migrate:all": "pnpm db:migrate && pnpm db:migrate:test",
    "db:migrate:branch": "dotenv -e .env.neon-branch -v ALLOW_NEON_DB=1 -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.prod -v ALLOW_NEON_DB=1 -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:branch": "dotenv -e .env.neon-branch -v ALLOW_NEON_DB=1 -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.prod -v ALLOW_NEON_DB=1 -- drizzle-kit studio",
    "db:journal:sync": "tsx scripts/db/backfill-journal.ts",
    "db:journal:sync:test": "dotenv -v DRIZZLE_TARGET=test -- tsx scripts/db/backfill-journal.ts",
    "db:journal:sync:prod": "dotenv -e .env.prod -v ALLOW_NEON_DB=1 -- tsx scripts/db/backfill-journal.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:pull-prod": "bash scripts/pull-prod-db.sh",
    "import:legacy": "tsx scripts/legacyDBMigration/import.ts",
    "design:veredillas-personal": "tsx scripts/veredillasPersonalCardDesign.ts",
    "backfill-photos:legacy": "tsx scripts/legacyDBMigration/backfillPhotos.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "konva": "^10.2.5",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^6.2.2",
    "react-konva": "^19.2.3",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vercel": "^58.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "_patchedDependencies_disabled": {
      "@nodable/entities@2.1.0": "patches/@nodable__entities@2.1.0.patch"
    }
  }
}
