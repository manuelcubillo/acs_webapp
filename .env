# =============================================================================
#  .env — VERSIONADO EN GIT. Solo valores NO secretos.
# =============================================================================
#
#  Este archivo define el objetivo POR DEFECTO: la pila local (Postgres + MinIO
#  en Docker). Un clon nuevo del repo arranca contra local sin configurar nada.
#
#  Next.js lo carga en TODOS los modos, pero las variables reales del proceso
#  (las que inyecta Vercel) SIEMPRE tienen prioridad sobre un fichero .env, así
#  que estos valores nunca pueden pisar producción.
#
#  Regla: aquí NO va ningún secreto ni ninguna variable NEXT_PUBLIC_* (esas se
#  incrustan en el bundle del cliente en tiempo de build). Ver .env.example.
#
#  Mapa completo de entornos: docs/ENVIRONMENTS.md
# =============================================================================

# ─── Base de datos ───────────────────────────────────────────────────────────
# "local" = node-postgres contra el contenedor acs-postgres.
# "neon"  = proxy HTTP de Neon (solo producción y ramas de Neon).
DB_DRIVER=local
DATABASE_URL=postgresql://acs_user:acs_password@localhost:5432/acs_dev

# ─── Almacenamiento de fotos (S3-compatible) ─────────────────────────────────
# MinIO local. Credenciales de juguete, idénticas a las de docker-compose.yml.
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=acs-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── Email ───────────────────────────────────────────────────────────────────
# Sin RESEND_APIKEY (va en .env.local), el envío se desactiva y los correos se
# vuelcan por consola. Ver src/lib/email/send.ts.
RESEND_FROM_EMAIL=noreply@veredillas.local
