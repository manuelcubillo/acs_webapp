# =============================================================================
#  .env.example — plantilla y documentación. VERSIONADO EN GIT.
# =============================================================================
#
#  No copies este fichero a .env: `.env` ya está versionado con los valores
#  buenos para desarrollo local. Lo único que necesita un clon nuevo es crear
#  .env.local y .env.test.local (ver más abajo).
#
#  ─── QUÉ FICHERO PONE QUÉ ───────────────────────────────────────────────────
#
#   Fichero               Git   Se carga...                        Objetivo
#   ────────────────────  ───   ────────────────────────────────   ─────────────────────
#   .env                   ✅   siempre (Next, drizzle, tests)     defaults locales, sin secretos
#   .env.development       ✅   solo `next dev`                    URLs de localhost
#   .env.local             ❌   siempre salvo en tests             secretos de dev
#   .env.test.local        ❌   solo `pnpm test`                   base de tests
#   .env.docker            ❌   solo `docker compose`              contenedores
#   .env.prod              ❌   solo scripts `*:prod` (explícito)  PRODUCCIÓN REAL
#   .env.neon-branch       ❌   solo scripts `*:branch` (explíc.)  rama de Neon
#
#  Prioridad: lo que carga dotenv-cli (los scripts `:prod` / `:branch`) gana
#  sobre .env.local, que gana sobre .env.development, que gana sobre .env.
#  Y las variables reales del proceso (las que inyecta Vercel) ganan a todas.
#
#  ─── ARRANQUE DESDE CERO ────────────────────────────────────────────────────
#
#    docker compose --profile db --profile storage up -d
#    cp .env.example .env.local     # y borra todo menos las 3 vars de dev
#    openssl rand -hex 32           # → BETTER_AUTH_SECRET
#    openssl rand -hex 32           # → CRON_SECRET
#    echo 'TEST_DATABASE_URL=postgresql://acs_user:acs_password@localhost:5432/acs_test' > .env.test.local
#    pnpm db:setup && pnpm dev
#
#  Mapa completo de entornos y tabla de comandos: docs/ENVIRONMENTS.md
# =============================================================================


# ─── Base de datos ───────────────────────────────────────────────────────────

# Selecciona el cliente drizzle en src/lib/db/index.ts:
#   "local" → node-postgres (protocolo wire). Postgres normal: Docker, self-host.
#   "neon"  → proxy HTTP de Neon. Obligatorio en el runtime serverless de Vercel.
# Definida en: .env (local) · .env.prod y .env.neon-branch (neon) · Vercel no la
# define, y el default del código es "neon".
DB_DRIVER=local

# Cadena de conexión. Definida en: .env · .env.prod · .env.neon-branch · .env.docker
DATABASE_URL=postgresql://acs_user:acs_password@localhost:5432/acs_dev

# Conexión a Neon SIN pgbouncer. Solo la necesita scripts/pull-prod-db.sh, porque
# pg_dump no funciona a través del pooler. Definida en: .env.prod
DATABASE_URL_UNPOOLED=

# Desactiva el guard que impide hablar con un Neon remoto desde un runtime que no
# es producción (src/lib/db/index.ts). NO la pongas en ningún fichero .env: la
# inyectan los scripts `:prod` / `:branch` de package.json, para que quede
# constancia en el comando que escribes.
# ALLOW_NEON_DB=1

# Solo tests. La lee src/test/setup-integration.ts, que la copia sobre
# DATABASE_URL y fuerza DB_DRIVER=local. Definida en: .env.test.local
TEST_DATABASE_URL=postgresql://acs_user:acs_password@localhost:5432/acs_test


# ─── Autenticación (Better Auth) ─────────────────────────────────────────────

# Firma las cookies de sesión. `openssl rand -hex 32`.
# ⚠️ UN SECRETO DISTINTO POR ENTORNO. Si dev y producción comparten secreto, una
# sesión firmada en tu portátil es válida en el sitio real.
# Definida en: .env.local · .env.test.local · .env.docker · .env.prod · Vercel
BETTER_AUTH_SECRET=

# URL base del servidor. Definida en: .env.development (localhost) · .env.docker · Vercel
BETTER_AUTH_URL=http://localhost:3000

# Misma URL, pero se INCRUSTA EN EL BUNDLE DEL CLIENTE en tiempo de build.
# Por eso vive en .env.development (que Next nunca carga en un build de
# producción) y no en .env. Definida en: .env.development · .env.docker · Vercel
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000


# ─── Email transaccional (Resend) ────────────────────────────────────────────

# Vacío = no se manda correo; los emails se vuelcan por consola
# (src/lib/email/send.ts). Deja SIEMPRE vacía la de producción fuera de Vercel.
# Definida en: .env.local (vacía) · .env.docker (vacía) · Vercel (la real)
RESEND_APIKEY=

# Debe ser un dominio verificado en la cuenta de Resend.
# Definida en: .env · .env.docker · Vercel
RESEND_FROM_EMAIL=noreply@veredillas.local


# ─── Cron / trabajos programados ─────────────────────────────────────────────

# Protege GET /api/cron/purge-archived (la purga diaria de la papelera).
# El llamante manda `Authorization: Bearer <CRON_SECRET>`. Si no está definida,
# el endpoint rechaza TODAS las peticiones (fail closed).
#   · Vercel  → Cron Jobs inyecta la cabecera solo si la variable está en el
#               proyecto. Sin ella el cron se ejecuta y siempre recibe un 401.
#   · Docker  → el contenedor `ofelia` manda la cabecera (ver docker-compose.yml).
#   · Local   → curl a mano, ver docs/ENVIRONMENTS.md.
# `openssl rand -hex 32`. Un valor distinto por entorno.
# Definida en: .env.local · .env.docker · .env.prod · Vercel
CRON_SECRET=


# ─── Almacenamiento de fotos (S3-compatible) ─────────────────────────────────

# "s3" = AWS S3 · "r2" = Cloudflare R2 · "minio" = MinIO (local / self-host).
# El driver decide el estilo de direccionamiento (path-style en MinIO,
# virtual-host en S3 y R2). No hay variable para eso.
# Definida en: .env (minio) · .env.docker (minio) · .env.prod · Vercel
STORAGE_DRIVER=minio

# Solo para proveedores con endpoint propio. El driver "s3" NO la lee: el SDK
# deriva https://s3.<region>.amazonaws.com de S3_REGION, que es además lo que
# firma. Se ignora a propósito — los ficheros de entorno se fusionan variable a
# variable, así que una config de S3 que se limitara a omitirla heredaría el
# valor de MinIO o de R2 y firmaría contra el host equivocado.
#   · R2:    https://<account-id>.r2.cloudflarestorage.com
#   · MinIO: http://localhost:9000 (host) · http://acs-minio:9000 (Compose)
S3_ENDPOINT=http://localhost:9000

# Escotilla del driver "s3" y solo suya: VPC interface endpoint o pasarela
# delante del bucket. Nombre propio para que ningún fichero de entorno de otro
# proveedor pueda colárselo por herencia. Vacía en el 99% de los casos.
# S3_ENDPOINT_OVERRIDE=

# S3: región real del bucket, obligatoria y sin valor por defecto — una región
# que no coincide con el bucket devuelve 301 PermanentRedirect en cada llamada.
# R2: se ignora (el adaptador fija "auto"). MinIO: cualquier cadena.
S3_REGION=us-east-1

S3_BUCKET=acs-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
