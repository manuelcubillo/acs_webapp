# =============================================================================
#  .env.development — VERSIONADO EN GIT. Solo valores NO secretos.
# =============================================================================
#
#  Next.js carga este fichero ÚNICAMENTE cuando NODE_ENV=development, es decir
#  solo en `next dev`. Nunca se carga en `next build` ni en `next start`, ni en
#  Vercel, ni dentro de la imagen Docker.
#
#  Por eso es el sitio seguro para las URLs de localhost: aquí una variable
#  NEXT_PUBLIC_* no puede acabar incrustada en un bundle de producción.
#
#  Mapa completo de entornos: docs/ENVIRONMENTS.md
# =============================================================================

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
